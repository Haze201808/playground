# --- AWS共通設定 ---
AWS_CA_BUNDLE=/home/hogehoge/.cert/odx_awscli_cert.pem

# --- Google Chat Webhook URL (共通) ---
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/YOUR_WEBHOOK_URL

# --- 各環境の AWS プロファイル名 ---
PROFILE_DEV=dev-account
PROFILE_UAT=uat-account
PROFILE_PROD=prod-account
PROFILE_HP=hp-account
PROFILE_BACK_PROD=back_prod-account

# --- 各環境の通知先スレッド名 (例: spaces/AAA/threads/BBB) ---
THREAD_DEV=YOUR_THREAD_NAME_DEV
THREAD_UAT=YOUR_THREAD_NAME_UAT
THREAD_PROD=YOUR_THREAD_NAME_PROD
THREAD_HP=YOUR_THREAD_NAME_HP
THREAD_BACK_PROD=YOUR_THREAD_NAME_BACK_PROD
