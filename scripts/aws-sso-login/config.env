# config.env.example

WEBHOOK_URL="https://chat.googleapis.com/v1/spaces/YOUR_SPACE/messages?key=YOUR_KEY&token=YOUR_TOKEN"
SPACE_ID="YOUR_SPACE_ID"
THREAD_ID="YOUR_THREAD_ID"

AWS_CA_BUNDLE_PATH="/path/to/your/cert.pem"
CHROME_PATH="/mnt/c/Program Files/Google/Chrome/Application/chrome.exe"

# ログイン対象プロファイル（スペース区切り）
PROFILES=("OdxSTProd.DeveloperSTProdAccess" "OdxSTDev.DeveloperDevAccess" "OdxSTUAT.DeveloperSTUATAccess" "ODXHpDev.DeveloperDevAccess")
